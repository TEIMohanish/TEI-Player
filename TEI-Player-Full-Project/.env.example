# Telegram bot credentials
API_ID=123456
API_HASH=REPLACE_WITH_TELEGRAM_API_HASH
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Shared secret between bot and Flask API (use a long random value)
BOT_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Existing MongoDB Atlas cluster (use a new rotated password)
# Add /tei_player before the query string so this app uses the tei_player database.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/tei_player?retryWrites=true&w=majority
MONGODB_DATABASE=tei_player

# Public URLs (fill these in after deploying)
PLAYER_BASE_URL=https://YOUR-PROJECT.vercel.app
PUBLIC_API_BASE_URL=https://YOUR-HTTPS-API-HOST
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Storage mounted on both API and bot containers
MEDIA_DIR=/media
FILE_RETENTION_HOURS=6
CLEANUP_INTERVAL_MINUTES=10
# Configure for a maximum of 4 GiB per incoming file; Telegram/library limits still apply.
MAX_UPLOAD_BYTES=4294967296
MAX_DOWNLOAD_BYTES=4294967296

# API server
PORT=5055
