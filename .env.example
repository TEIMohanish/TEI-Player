# TEI Player — environment template
# Copy this file to .env on the VPS and replace every placeholder.
# Never commit your real .env file to GitHub.

# Telegram bot credentials
API_ID=YOUR_TELEGRAM_API_ID
API_HASH=YOUR_TELEGRAM_API_HASH
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Numeric Telegram user ID allowed to use /admin and owner controls
OWNER_ID=YOUR_TELEGRAM_NUMERIC_USER_ID

# Shared secret between Telegram bot and Flask API
# Generate a long random secret and use the same value for both services.
BOT_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# MongoDB Atlas — use your rotated database-user password.
# URL-encode special characters in the username/password if needed.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/tei_player?retryWrites=true&w=majority
MONGODB_DATABASE=tei_player

# Public URLs — set these after deployment.
# PLAYER_BASE_URL is your Vercel frontend URL.
PLAYER_BASE_URL=https://YOUR-PROJECT.vercel.app
# PUBLIC_API_BASE_URL is the stable HTTPS URL that points to the VPS Flask API.
PUBLIC_API_BASE_URL=https://YOUR-HTTPS-API-HOST
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Shared media directory inside Docker containers
MEDIA_DIR=/media

# File retention and cleanup
FILE_RETENTION_HOURS=6
CLEANUP_INTERVAL_MINUTES=10

# Application file-size limits (4 GiB; does not override Telegram/Pyrogram limits)
MAX_UPLOAD_BYTES=4294967296
MAX_DOWNLOAD_BYTES=4294967296

# Bot behavior
MAX_CONCURRENT_PER_USER=1
MIN_FREE_DISK_GIB=2
PROGRESS_EDIT_SECONDS=5

# Flask API server
PORT=5055
